{
  "schema_version": 1,
  "title": "Mercata marketplace economics ontology",
  "description": "Complete independent public domain vocabulary for market, earnings and opportunity research.",
  "entities": [
    {
      "id": "marketplace",
      "definition": "Platform connecting makers, service providers or publishers to buyers or audiences.",
      "attributes": [
        "name",
        "official_url",
        "roles",
        "jurisdictions"
      ],
      "relates_to": [
        "opportunity",
        "fee",
        "eligibility",
        "payout"
      ]
    },
    {
      "id": "platform_role",
      "definition": "Economic function: marketplace, channel, publisher, payment rail, or broker.",
      "attributes": [
        "id",
        "definition"
      ],
      "relates_to": [
        "marketplace"
      ]
    },
    {
      "id": "product_type",
      "definition": "Good, license, digital work, professional service or subscribed benefit.",
      "attributes": [
        "id",
        "type",
        "delivery"
      ],
      "relates_to": [
        "opportunity"
      ]
    },
    {
      "id": "opportunity",
      "definition": "Specific route to revenue through a platform.",
      "attributes": [
        "product_type",
        "buyer",
        "monetization",
        "discovery"
      ],
      "relates_to": [
        "marketplace",
        "experiment"
      ]
    },
    {
      "id": "eligibility",
      "definition": "An access, residency, identity, audience or qualification condition.",
      "attributes": [
        "condition",
        "jurisdiction",
        "effective_date"
      ],
      "relates_to": [
        "marketplace",
        "claim"
      ]
    },
    {
      "id": "fee",
      "definition": "An entry, sale, processing, refund or withdrawal charge.",
      "attributes": [
        "kind",
        "amount",
        "currency",
        "rate",
        "basis"
      ],
      "relates_to": [
        "marketplace",
        "claim"
      ]
    },
    {
      "id": "payout",
      "definition": "Payment method, minimum amount, timing and regional restriction.",
      "attributes": [
        "method",
        "threshold",
        "country",
        "settlement"
      ],
      "relates_to": [
        "marketplace",
        "claim"
      ]
    },
    {
      "id": "audience",
      "definition": "Buyers, potential buyers, clients or viewers in a defined segment.",
      "attributes": [
        "segment",
        "period",
        "sample"
      ],
      "relates_to": [
        "marketplace",
        "observation"
      ]
    },
    {
      "id": "market_metric",
      "definition": "Definition of a measurable market or income quantity.",
      "attributes": [
        "unit",
        "population",
        "denominator",
        "gross_net"
      ],
      "relates_to": [
        "observation"
      ]
    },
    {
      "id": "observation",
      "definition": "Dated reported or measured value for a defined metric.",
      "attributes": [
        "value",
        "period",
        "population",
        "method",
        "limitations"
      ],
      "relates_to": [
        "market_metric",
        "claim"
      ]
    },
    {
      "id": "income_distribution",
      "definition": "Population income spread and zero-earner inclusion.",
      "attributes": [
        "mean",
        "median",
        "percentiles",
        "zeros",
        "sample"
      ],
      "relates_to": [
        "observation"
      ]
    },
    {
      "id": "trend",
      "definition": "Comparable series of metric observations over time.",
      "attributes": [
        "metric",
        "series",
        "comparability"
      ],
      "relates_to": [
        "observation"
      ]
    },
    {
      "id": "competition",
      "definition": "Supply, concentration, pricing and differentiation in a segment.",
      "attributes": [
        "population",
        "prices",
        "sample"
      ],
      "relates_to": [
        "observation",
        "claim"
      ]
    },
    {
      "id": "right",
      "definition": "Ownership, license, exclusivity, takedown or portability term.",
      "attributes": [
        "scope",
        "jurisdiction",
        "effective_date"
      ],
      "relates_to": [
        "marketplace",
        "claim"
      ]
    },
    {
      "id": "risk",
      "definition": "Threat to economic access, payout, demand, rights or continuity.",
      "attributes": [
        "kind",
        "likelihood",
        "impact",
        "limitations"
      ],
      "relates_to": [
        "claim",
        "opportunity"
      ]
    },
    {
      "id": "source",
      "definition": "Public origin of a checkable assertion.",
      "attributes": [
        "url",
        "publisher",
        "published_at",
        "retrieved_at",
        "evidence_class",
        "license"
      ],
      "relates_to": [
        "claim"
      ]
    },
    {
      "id": "claim",
      "definition": "Atomic statement backed by one or more public sources.",
      "attributes": [
        "text",
        "confidence",
        "date",
        "source_ids",
        "limitations"
      ],
      "relates_to": [
        "source",
        "observation"
      ]
    },
    {
      "id": "experiment",
      "definition": "Bounded test of a strategy with effort, costs and outcomes.",
      "attributes": [
        "hypothesis",
        "cost",
        "hours",
        "method",
        "result"
      ],
      "relates_to": [
        "opportunity",
        "claim"
      ]
    },
    {
      "id": "specimen",
      "definition": "Versioned independent marketplace research dossier.",
      "attributes": [
        "id",
        "marketplace",
        "status",
        "color",
        "sources"
      ],
      "relates_to": [
        "marketplace",
        "queue"
      ]
    },
    {
      "id": "queue",
      "definition": "Group of research tasks on a common topic.",
      "attributes": [
        "id",
        "tasks",
        "objective"
      ],
      "relates_to": [
        "task",
        "specimen"
      ]
    },
    {
      "id": "task",
      "definition": "Atomic research action with measurable acceptance evidence.",
      "attributes": [
        "id",
        "weight",
        "percent",
        "evidence",
        "acceptance"
      ],
      "relates_to": [
        "queue",
        "claim"
      ]
    },
    {
      "id": "platform_audience",
      "definition": "Population of platform users, visitors, viewers or reachable advertising accounts.",
      "attributes": [
        "population_definition",
        "region",
        "period",
        "metric",
        "source_ids"
      ],
      "relates_to": [
        "marketplace",
        "audience_estimate"
      ]
    },
    {
      "id": "audience_segment",
      "definition": "Descriptive aggregate group defined by one or more measured characteristics.",
      "attributes": [
        "definition",
        "population",
        "geography",
        "period"
      ],
      "relates_to": [
        "demographic_measurement",
        "community"
      ]
    },
    {
      "id": "demographic_measurement",
      "definition": "Documented age, gender, sex, ethnicity, country, language or other aggregate distribution.",
      "attributes": [
        "dimension",
        "category",
        "share_percent",
        "population",
        "source_ids",
        "method"
      ],
      "relates_to": [
        "platform_audience",
        "audience_segment"
      ]
    },
    {
      "id": "subculture",
      "definition": "Documented topical or social content community with flexible, overlapping membership.",
      "attributes": [
        "id",
        "definition",
        "aliases",
        "parents",
        "measurements"
      ],
      "relates_to": [
        "marketplace",
        "audience_segment",
        "community_overlap"
      ]
    },
    {
      "id": "audience_estimate",
      "definition": "Population or engagement estimate with a distinct statistical unit and method.",
      "attributes": [
        "metric",
        "unit",
        "value",
        "population",
        "geography",
        "period",
        "source_ids",
        "limitations"
      ],
      "relates_to": [
        "platform_audience",
        "subculture"
      ]
    },
    {
      "id": "community_overlap",
      "definition": "Measured intersection of two or more communities.",
      "attributes": [
        "community_ids",
        "value",
        "unit",
        "period",
        "source_ids"
      ],
      "relates_to": [
        "subculture"
      ]
    },
    {
      "id": "content_format",
      "definition": "Medium, structure or distribution format for public creative content.",
      "attributes": [
        "label",
        "constraints",
        "measurement"
      ],
      "relates_to": [
        "subculture"
      ]
    },
    {
      "id": "audience_opportunity",
      "definition": "Evidence-backed content niche and commercial hypothesis.",
      "attributes": [
        "target_interest",
        "format",
        "demand",
        "supply",
        "cost",
        "monetization",
        "limitations"
      ],
      "relates_to": [
        "opportunity",
        "audience_segment",
        "subculture"
      ]
    }
  ],
  "vocabularies": {
    "domain": [
      "games",
      "literature",
      "software",
      "services",
      "video",
      "art",
      "digital-products",
      "subscriptions",
      "other"
    ],
    "role": [
      "marketplace",
      "publishing_outlet",
      "audience_channel",
      "payment_processor",
      "contract_broker",
      "subscription_platform"
    ],
    "specimen_status": [
      "queued",
      "researching",
      "review",
      "published",
      "archived"
    ],
    "evidence_class": [
      "official",
      "independent",
      "survey",
      "anecdotal",
      "estimated",
      "modeled"
    ],
    "confidence": [
      "high",
      "medium",
      "low",
      "unknown"
    ],
    "metric_basis": [
      "gross_revenue",
      "net_payout",
      "profit",
      "effective_hourly_earnings",
      "cost",
      "count",
      "ratio"
    ],
    "task_status": [
      "pending",
      "in_progress",
      "blocked",
      "complete"
    ],
    "research_profile": [
      "social_audience"
    ],
    "audience_dimension": [
      "age",
      "gender",
      "sex",
      "race_ethnicity",
      "country",
      "language",
      "education",
      "household_income",
      "political_affiliation",
      "religion",
      "urbanicity",
      "other"
    ],
    "audience_units": [
      "people",
      "users",
      "accounts",
      "ad-reach",
      "creators",
      "channels",
      "videos",
      "posts",
      "views",
      "watch-hours",
      "live-viewers",
      "percent",
      "other"
    ]
  },
  "relations": [
    {
      "subject": "specimen",
      "predicate": "studies",
      "object": "marketplace"
    },
    {
      "subject": "marketplace",
      "predicate": "offers",
      "object": "opportunity"
    },
    {
      "subject": "opportunity",
      "predicate": "tested_by",
      "object": "experiment"
    },
    {
      "subject": "claim",
      "predicate": "supported_by",
      "object": "source"
    },
    {
      "subject": "observation",
      "predicate": "describes",
      "object": "market_metric"
    },
    {
      "subject": "income_distribution",
      "predicate": "derived_from",
      "object": "observation"
    },
    {
      "subject": "trend",
      "predicate": "contains",
      "object": "observation"
    },
    {
      "subject": "queue",
      "predicate": "contains",
      "object": "task"
    },
    {
      "subject": "marketplace",
      "predicate": "has_audience",
      "object": "platform_audience"
    },
    {
      "subject": "subculture",
      "predicate": "estimated_by",
      "object": "audience_estimate"
    },
    {
      "subject": "subculture",
      "predicate": "overlaps",
      "object": "community_overlap"
    },
    {
      "subject": "audience_segment",
      "predicate": "measured_by",
      "object": "demographic_measurement"
    },
    {
      "subject": "audience_opportunity",
      "predicate": "serves",
      "object": "subculture"
    }
  ],
  "rules": [
    "An empty specimen contains no verified findings.",
    "Marketplace functions are independent and may overlap.",
    "A source-backed claim is not necessarily representative of platform-wide earnings.",
    "Mean, median and zero-earner share require explicit denominator and period.",
    "Gross revenue, net payout, profit and hourly earnings are distinct metrics.",
    "Missing numeric values are unknown, not zero.",
    "Economic claims must record public provenance and applicable jurisdiction.",
    "Trend comparisons must use compatible definitions.",
    "Each task at 100 percent needs acceptance evidence.",
    "Specimen colors are identifiers, never rankings.",
    "Platform MAU, ad reach, registered accounts, creators, channels, viewers and views are different measures.",
    "Demographic estimates require source, geography, time, survey or analytics population, and limitations.",
    "Sex and gender are separate measures; identity data is used only in aggregate where reliable and authorized.",
    "Political affiliation and race or ethnicity must not be inferred from individuals, appearance or consumption.",
    "Community labels can overlap. Never sum community sizes without deduplication.",
    "Search result totals and aggregate content views are not unique users.",
    "Children's content requires child-directed content policy review and cannot justify profiling children.",
    "Missing data stays unknown. Do not claim exact population size from samples without explicit estimation methods.",
    "Descriptive political-audience research does not authorize persuasive demographic political targeting.",
    "Platform-specific claim and policy catalogs must use cited public evidence and preserve their effective date and jurisdiction.",
    "Eligibility threshold, percentage revenue share, audience estimate and creator earning are separate data types.",
    "Creator-facing analytics do not describe the full platform population unless the report's own denominator warrants it."
  ],
  "specimen_schema": "specimen.schema.json",
  "audience_schema": "audience.schema.json",
  "social_research_queues": "../pipeline/social.json",
  "platform_specific": {
    "youtube": {
      "human": "youtube/README.md",
      "concepts": "youtube/model.json",
      "topics": "youtube/taxonomy.json",
      "policies": "youtube/policies.json",
      "metrics": "youtube/measurements.json",
      "measurement_history": "youtube/measurement-history.json",
      "economic_model": "youtube/economic-model.json"
    }
  }
}
