  "comparison_contract": {
    "required_store_observations": [
      "same_exact_game_and_build_edition",
      "same_paid_product_type_and_price_currency",
      "same_undiscounted_price_or_normalized_actual_revenue_with_explicit_discount",
      "matched_price_and_release_age_window",
      "same_merchant_payout_basis_gross_before_tax_or_after_refunds",
      "aligned_owner_marketing_exposure",
      "store_specific_gross_orders_refunds_fees_and_actual_cash",
      "store_specific_porting_qa_and_player_support_hours",
      "explicit_right_censoring"
    ],
    "event_windows_days": [
      7,
      30,
      90,
      365
    ],
    "structural_cautions": [
      "Store-specific buyer populations and discovery algorithms are inherently different; aligned product outcomes do not prove causal superiority.",
      "An all-store cumulative total minus one store's sales is not another store's verified net payout if units and fee classes differ.",
      "Presale wishlists, downloads, key activations and browser plays are not retained paid game orders.",
      "Earlier/later storefront launches differ in calendar promotions, age and existing earned attention.",
      "Refund-adjusted income requires merchant owner-authorized transaction and transfer records per store.",
      "Do not treat cross-store exposure as a fixed audience or assume another storefront adds only new buyers.",
      "Unreported outside platform share, technical porting, localization and support hours remain unknown and cannot be set to zero.",
      "Check the arithmetic sum of listed storefront monetary amounts independently against a publisher's declared grand total; preserve discrepancies as unresolved until a ledger explains them.",
      "Reported deposits or bank cash may lag same-post gross unit totals and must not be compared as if settled over the identical earning window."
    ],
    "validator_guards": {
      "strict_same_utc_second_precision_and_real_calendar_date": true,
      "strict_start_before_end": true,
      "nonnegative_safe_integer_paid_order_counts": true,
      "nonnegative_safe_integer_release_age_days": true,
      "all_required_text_fields_nonblank": true,
      "three_letter_uppercase_iso_style_currency_code": true,
      "numeric_costs_and_receipts_finite_nonnegative": true,
      "matched_record_schema_alone_is_not_verified_transaction_authentication": true,
      "positive_minimum_price_required_for_premium_game": true,
      "positive_gross_if_completed_positive_price_orders_present": true
    }
