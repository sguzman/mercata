  "source_ids": [
    "itch-started",
    "itch-html5",
    "butler-push",
    "itch-download-keys",
    "itch-quality"
  ],
  "entities": [
    {
      "id": "publisher_account",
      "key": "account_id",
      "relation": "can own one or more project_pages",
      "not_equivalent_to": [
        "developer_person",
        "active_paid_seller"
      ]
    },
    {
      "id": "project_page",
      "key": "page_id",
      "relation": "one project page can expose multiple files, upload channels and builds",
      "not_equivalent_to": [
        "independent_commercial_game",
        "payment",
        "unique_developer"
      ]
    },
    {
      "id": "file_upload",
      "key": "page_id + file_id",
      "relation": "an uploaded demo/full game/asset/bonus/browser archive; can have versions via butler",
      "not_equivalent_to": [
        "standalone_game",
        "purchase"
      ]
    },
    {
      "id": "channel",
      "key": "page_id + channel_id",
      "relation": "one named release channel may have many historical build revisions",
      "not_equivalent_to": [
        "distinct_listing",
        "distinct_game",
        "paid_unit"
      ]
    },
    {
      "id": "build",
      "key": "page_id + channel_id + build_id",
      "relation": "one release revision in a channel",
      "not_equivalent_to": [
        "unique_game",
        "customer"
      ]
    },
    {
      "id": "download_key",
      "key": "unknown_private_key",
      "relation": "grants access after some purchases or manual issuance",
      "not_equivalent_to": [
        "one_unique_buyer",
        "one_settled_paid_order"
      ]
    },
    {
      "id": "paid_order",
      "key": "private_transaction_id",
      "relation": "owner-only payment event with fees/refunds and explicit game allocation",
      "not_equivalent_to": [
        "download",
        "browser_play",
        "file_upload"
      ]
    }
  ],
  "sample_public_page_count": null,
